{
  "$schema": "http://json-schema.org/schema",
  "name": "@onward-partners/nx-bun",
  "version": "0.0.1",
  "generators": {
    "init": {
      "factory": "./src/generators/init/generator",
      "schema": "./src/generators/init/schema.json",
      "description": "Register the plugin in nx.json and add Bun's types",
      "hidden": true
    },
    "application": {
      "factory": "./src/generators/application/generator",
      "schema": "./src/generators/application/schema.json",
      "description": "Create an application that runs, builds and tests with Bun",
      "x-type": "application",
      "aliases": ["app"]
    },
    "library": {
      "factory": "./src/generators/library/generator",
      "schema": "./src/generators/library/schema.json",
      "description": "Create a library that builds and tests with Bun",
      "x-type": "library",
      "aliases": ["lib"]
    },
    "project": {
      "factory": "./src/generators/project/generator",
      "schema": "./src/generators/project/schema.json",
      "description": "Add Bun to an existing project",
      "aliases": ["configuration"]
    }
  }
}
